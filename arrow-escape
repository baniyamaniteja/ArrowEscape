#!/usr/bin/env bash
# Arrow Escape launcher for Ubuntu / Linux desktops.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
INDEX="$HERE/www/index.html"
ICON="$HERE/icon.png"
export ARROW_ESCAPE_HOME="$HERE"

if [[ ! -f "$INDEX" ]]; then
  echo "Arrow Escape game files were not found next to the launcher." >&2
  exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

try_webkit() {
  if have python3 && python3 - <<'PY'
import importlib.util, sys
sys.exit(0 if importlib.util.find_spec("gi") else 1)
PY
  then
    python3 "$HERE/arrow-escape.py"
    return $?
  fi
  return 127
}

try_chrome_app() {
  local uri="file://$INDEX"
  local bin
  for bin in google-chrome-stable google-chrome chromium-browser chromium brave-browser microsoft-edge; do
    if have "$bin"; then
      exec "$bin" --app="$uri" --class=ArrowEscape --user-data-dir="$HOME/.local/share/arrow-escape/browser" --no-first-run --disable-extensions
    fi
  done
  return 127
}

try_firefox() {
  if have firefox; then
    exec firefox --new-window "file://$INDEX"
  fi
  return 127
}

try_xdg() {
  if have xdg-open; then
    exec xdg-open "file://$INDEX"
  fi
  return 127
}

try_webkit || try_chrome_app || try_firefox || try_xdg || {
  echo "Arrow Escape needs a browser engine. On Ubuntu run:" >&2
  echo "  sudo apt install python3-gi gir1.2-gtk-3.0 gir1.2-webkit2-4.1" >&2
  exit 1
}
